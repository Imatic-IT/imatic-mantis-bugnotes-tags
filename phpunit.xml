<?xml version="1.0" encoding="UTF-8"?>
<!--
    ImaticBugnotesTags test suite.

    Standalone runner for local development:
        vendor/bin/phpunit -c plugins/ImaticBugnotesTags/phpunit.xml

    CI runs this same file as its own step (.github/workflows/cd.yml), so a
    failure here blocks the stage deploy. It is deliberately not folded into
    the repository root phpunit.xml: that file comes from upstream MantisBT
    and any edit to it would have to be carried forward as a patch on every
    upgrade.

    There is only an "integration" suite: unlike EmailReporting, this plugin
    has no pure-PHP logic of its own — every action is a handful of DB reads
    and writes plus MantisBT's own access checks, so a real Mantis + database
    is what a meaningful test needs. See tests/bootstrap.php.
-->
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    >

    <testsuites>
        <testsuite name="integration">
            <directory>tests/integration</directory>
        </testsuite>
    </testsuites>

</phpunit>
